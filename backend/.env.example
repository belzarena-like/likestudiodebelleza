# ============================================================================
# Like Studio Backend - Environment Configuration
# ============================================================================
# Copy this file to .env and fill in your actual values
# NEVER commit .env to version control!

# ── Database Configuration ──────────────────────────────────────────────────
# SQLite (default for development)
DATABASE_URL=sqlite:///./likestudio.db

# PostgreSQL (recommended for production)
# DATABASE_URL=postgresql://username:password@localhost:5432/likestudio

# MySQL/MariaDB
# DATABASE_URL=mysql+pymysql://username:password@localhost:3306/likestudio


# ── AWS S3 Configuration (for Training Videos) ─────────────────────────────
# Required for video upload/streaming functionality
AWS_ACCESS_KEY_ID=your_aws_access_key_here
AWS_SECRET_ACCESS_KEY=your_aws_secret_key_here
AWS_REGION=us-east-1

# S3 bucket name for training videos
S3_TRAINING_BUCKET=likestudio-training

# Pre-signed URL expiry time in seconds (default: 3600 = 1 hour)
S3_PRESIGN_EXPIRY_SECONDS=3600


# ── Server Configuration ────────────────────────────────────────────────────
# Host and port for uvicorn server
HOST=0.0.0.0
PORT=8000

# Environment (development, staging, production)
ENVIRONMENT=development


# ── Security Configuration ──────────────────────────────────────────────────
# Secret key for JWT tokens (generate a secure random string)
# You can generate one with: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=your_secret_key_here_change_this_in_production

# CORS allowed origins (comma-separated)
# For development: http://localhost:3000,http://127.0.0.1:5500
# For production: https://yourdomain.com
CORS_ORIGINS=*


# ── Optional: Email Configuration ──────────────────────────────────────────
# For sending appointment reminders, consent notifications, etc.
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=your_email@gmail.com
# SMTP_PASSWORD=your_app_password
# SMTP_FROM=noreply@likestudio.com


# ── Optional: Logging ───────────────────────────────────────────────────────
# LOG_LEVEL=INFO
# LOG_FILE=./logs/likestudio.log


# ── Notes ───────────────────────────────────────────────────────────────────
# 1. For SQLite: No additional setup needed, file will be created automatically
# 2. For PostgreSQL/MySQL: Create the database first, then run the backend
# 3. AWS S3: Create bucket and configure CORS policy for direct browser uploads
# 4. Passlib (bcrypt) is required for secure password hashing
# 5. Boto3 is required for S3 video uploads
